{
  "name": "@aldotestino/autoland",
  "version": "0.1.0",
  "description": "Land a batch of pull requests in order, one at a time: update, wait for checks, approve, merge.",
  "keywords": [
    "cli",
    "github",
    "merge",
    "merge-queue",
    "pull-request"
  ],
  "homepage": "https://github.com/aldotestino/autoland#readme",
  "bugs": {
    "url": "https://github.com/aldotestino/autoland/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldotestino/autoland.git"
  },
  "bin": {
    "autoland": "src/cli.ts"
  },
  "type": "module",
  "module": "src/cli.ts",
  "publishConfig": {
    "access": "public",
    "directory": "dist/npm/autoland"
  },
  "scripts": {
    "autoland": "bun src/cli.ts",
    "build": "bun build src/cli.ts --compile --outfile dist/autoland",
    "build:npm": "bun scripts/build-npm.ts",
    "changeset": "changeset",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "effect-tsgo --tsrs-lint oxlint",
    "lint:fix": "effect-tsgo --tsrs-lint oxlint --fix",
    "prepare": "effect-tsgo patch --typescript --oxlint --tsrs",
    "release": "bun scripts/prepare-release.ts && changeset publish",
    "test": "vitest run",
    "typecheck": "tsrs --noEmit --fast",
    "version-packages": "changeset version && bun install"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@opencode/client": "2.2.5",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "0.67.1",
    "@effect/vitest": "4.0.6",
    "@types/bun": "1.4.4",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "typescript": "^7.1.0-beta",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  }
}
