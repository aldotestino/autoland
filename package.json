{
  "name": "autoland",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "autoland": "src/cli.ts"
  },
  "type": "module",
  "module": "src/cli.ts",
  "scripts": {
    "autoland": "bun src/cli.ts",
    "build": "bun build src/cli.ts --compile --outfile dist/autoland",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsrs --noEmit",
    "prepare": "effect-tsgo patch --typescript --oxlint --tsrs"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@opencode/client": "2.2.5",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.0.6",
    "@types/bun": "1.4.4",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "^7.1.0-beta",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  }
}
